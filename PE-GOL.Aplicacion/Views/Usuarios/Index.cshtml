@model UsuariosIndexViewModel
@{
    ViewData["Title"] = "Usuarios de Tenants";
    var roles = new[] { "AdminTenant", "Gerente", "JefeArea" };
    var estados = new[] { "Activo", "Inactivo", "Bloqueado" };

    // Catálogo de tenants para resolver el nombre en la fila (UsuarioResponse trae solo el id).
    var tenantsPorId = Model.Tenants.ToDictionary(t => t.Id);

    string ClaseRol(string rol) => rol switch
    {
        "AdminTenant" => "badge border text-primary",
        "Gerente" => "badge border text-success",
        _ => "badge border text-warning"
    };
    string ClaseEstado(string estado) => estado switch
    {
        "Activo" => "semaforo semaforo--verde",
        "Inactivo" => "semaforo semaforo--rojo",
        _ => "semaforo semaforo--amarillo"
    };
}

<div class="page-header">
    <div class="page-header__breadcrumb">
        <span>Administración SaaS</span>
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
        <span class="active">Usuarios</span>
    </div>
    <h1 class="page-header__title">Usuarios de Tenants</h1>
    <p class="page-header__subtitle">@Model.Total registro(s) · Página @Model.Page de @(Model.TotalPages > 0 ? Model.TotalPages : 1)</p>
</div>

@if (TempData["Success"] is string mensajeExito)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle" aria-hidden="true"></i> @mensajeExito
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData["Error"] is string mensajeError)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @mensajeError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@* ── Barra de filtros (form GET a Index) ── *@
<div class="card-pe mb-4">
    <form method="get" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-md-2">
            <label class="form-pe-label" for="rol">Rol</label>
            <select class="form-pe-select" id="rol" name="rol">
                <option value="">Todos</option>
                @foreach (var r in roles)
                {
                    <option value="@r" selected="@(Model.RolFiltro == r)">@r</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-pe-label" for="estado">Estado</label>
            <select class="form-pe-select" id="estado" name="estado">
                <option value="">Todos</option>
                @foreach (var e in estados)
                {
                    <option value="@e" selected="@(Model.EstadoFiltro == e)">@e</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-pe-label" for="tenantId">Tenant</label>
            <select class="form-pe-select" id="tenantId" name="tenantId">
                <option value="">Todos los tenants</option>
                @foreach (var tenant in Model.Tenants)
                {
                    <option value="@tenant.Id" selected="@(Model.TenantIdFiltro == tenant.Id)">@tenant.Nombre</option>
                }
            </select>
        </div>
        <div class="col-md-5 d-flex gap-2">
            <button type="submit" class="btn-pe btn-pe--primary">
                <i class="bi bi-funnel" aria-hidden="true"></i> Filtrar
            </button>
            <a class="btn-pe btn-pe--secondary" asp-action="Index">
                <i class="bi bi-x-lg" aria-hidden="true"></i> Limpiar
            </a>
            <a class="btn-pe btn-pe--primary ms-auto" asp-action="Crear">
                <i class="bi bi-person-plus" aria-hidden="true"></i> Nuevo Usuario
            </a>
        </div>
    </form>
</div>

@if (Model.Items.Count == 0)
{
    @* ── Estado vacío (UX-05) ── *@
    <div class="card-pe">
        <div class="empty-state">
            <i class="bi bi-people empty-state__icon" aria-hidden="true"></i>
            <h3 class="empty-state__title">No hay usuarios registrados</h3>
            <p class="empty-state__message">Crea el primer usuario (AdminTenant) para que la gerencia pueda operar en la plataforma.</p>
            <a class="btn-pe btn-pe--primary" asp-action="Crear">
                <i class="bi bi-person-plus" aria-hidden="true"></i> Nuevo Usuario
            </a>
        </div>
    </div>
}
else
{
    @* ── Tabla (UX-03) ── *@
    <div class="card-pe p-0">
        <div class="table-responsive">
            <table class="tabla-pe mb-0">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Correo</th>
                        <th>Rol</th>
                        <th>Tenant</th>
                        <th>Estado</th>
                        <th>Pwd</th>
                        <th>Creado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in Model.Items)
                    {
                        tenantsPorId.TryGetValue(usuario.TenantId ?? Guid.Empty, out var tenant);
                        <tr>
                            <td class="fw-semibold">@usuario.Nombre</td>
                            <td class="cell-truncate d-inline-block" title="@usuario.Correo">@usuario.Correo</td>
                            <td><span class="@ClaseRol(usuario.Rol)">@usuario.Rol</span></td>
                            <td>
                                @if (tenant is not null)
                                {
                                    @tenant.Nombre
                                }
                                else if (usuario.TenantId == null)
                                {
                                    <span class="text-secondary">SaaS</span>
                                }
                                else
                                {
                                    <span class="text-secondary">—</span>
                                }
                            </td>
                            <td><span class="@ClaseEstado(usuario.Estado)"><i class="bi bi-circle-fill" aria-hidden="true"></i> @usuario.Estado</span></td>
                            <td>
                                @if (usuario.RequiereCambioPwd)
                                {
                                    <span class="badge border text-warning" title="Debe cambiar la contraseña en el próximo inicio">Sí</span>
                                }
                                else
                                {
                                    <span class="badge border text-secondary" title="Contraseña ya establecida">No</span>
                                }
                            </td>
                            <td>@usuario.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a class="btn-pe btn-pe--secondary btn-pe--sm" asp-action="Editar" asp-route-id="@usuario.Id" title="Editar">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </a>
                                    @if (usuario.Estado == "Activo")
                                    {
                                        <button type="button" class="btn-pe btn-pe--secondary btn-pe--sm"
                                                data-bs-toggle="modal" data-bs-target="#modalConfirmarAccion"
                                                data-usuario-id="@usuario.Id" data-usuario-nombre="@usuario.Nombre" data-accion="desactivar"
                                                title="Desactivar">
                                            <i class="bi bi-stop-circle" aria-hidden="true"></i>
                                        </button>
                                    }
                                    else if (usuario.Estado != "Bloqueado")
                                    {
                                        <button type="button" class="btn-pe btn-pe--secondary btn-pe--sm"
                                                data-bs-toggle="modal" data-bs-target="#modalConfirmarAccion"
                                                data-usuario-id="@usuario.Id" data-usuario-nombre="@usuario.Nombre" data-accion="activar"
                                                title="Activar">
                                            <i class="bi bi-play-circle" aria-hidden="true"></i>
                                        </button>
                                    }
                                    <button type="button" class="btn-pe btn-pe--secondary btn-pe--sm"
                                            data-bs-toggle="modal" data-bs-target="#modalConfirmarAccion"
                                            data-usuario-id="@usuario.Id" data-usuario-nombre="@usuario.Nombre" data-accion="reset"
                                            title="Resetear contraseña">
                                        <i class="bi bi-key" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* ── Paginación (preserva filtros activos) ── *@
    <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 gap-2">
        <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
            <input type="hidden" name="rol" value="@Model.RolFiltro" />
            <input type="hidden" name="estado" value="@Model.EstadoFiltro" />
            <input type="hidden" name="tenantId" value="@Model.TenantIdFiltro" />
            <label class="form-pe-label mb-0" for="pageSize">Registros por página</label>
            <select class="form-pe-select w-auto" id="pageSize" name="pageSize" onchange="this.form.submit()">
                <option value="10" selected="@(Model.PageSize == 10)">10</option>
                <option value="25" selected="@(Model.PageSize == 25)">25</option>
                <option value="50" selected="@(Model.PageSize == 50)">50</option>
            </select>
        </form>

        <nav aria-label="Paginación de usuarios">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize"
                       asp-route-rol="@Model.RolFiltro" asp-route-estado="@Model.EstadoFiltro" asp-route-tenantId="@Model.TenantIdFiltro">Anterior</a>
                </li>
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@i" asp-route-pageSize="@Model.PageSize"
                           asp-route-rol="@Model.RolFiltro" asp-route-estado="@Model.EstadoFiltro" asp-route-tenantId="@Model.TenantIdFiltro">@i</a>
                    </li>
                }
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize"
                       asp-route-rol="@Model.RolFiltro" asp-route-estado="@Model.EstadoFiltro" asp-route-tenantId="@Model.TenantIdFiltro">Siguiente</a>
                </li>
            </ul>
        </nav>
    </div>
}

@* ── Modal de confirmación (activar/desactivar/reset — DS § 5.7) ── *@
<div class="modal fade modal-pe" id="modalConfirmarAccion" tabindex="-1" aria-labelledby="modalConfirmarTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalConfirmarTitulo">Confirmar acción</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="body-md mb-0" id="modalConfirmarTexto"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-pe btn-pe--secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="formConfirmarAccion" method="post" action="">
                    <button type="submit" id="modalConfirmarBoton" class="btn-pe btn-pe--danger">Confirmar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/usuarios.js" asp-append-version="true"></script>
}