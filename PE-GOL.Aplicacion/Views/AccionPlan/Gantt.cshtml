@model AccionPlanGanttViewModel
@{
    ViewData["Title"] = "Gantt del Plan";
    var esGerente = User.IsInRole("Gerente");
    // El breadcrumb refleja la sección real del _Sidebar donde vive el ítem (F7).
    var seccion = esGerente ? "Contenido" : "Mi Área";

    int Conteo(string clave) => Model.ConteoPorStatus.TryGetValue(clave, out var n) ? n : 0;
    int TotalAcciones() => Model.ConteoPorStatus.Values.Sum();
}

<div class="page-header">
    <div class="page-header__breadcrumb">
        <span>@seccion</span>
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
        <span class="active">Gantt del Plan</span>
    </div>
    <h1 class="page-header__title">Gantt del Plan de Acción</h1>
    <p class="page-header__subtitle">
        @if (Model.HayCicloActivo)
        {
            <text>Distribución temporal de las acciones del plan del ciclo <strong>@Model.CicloNombre</strong>, agrupadas por Objetivo CG.</text>
        }
        else
        {
            <text>Distribución temporal de las acciones del plan del ciclo activo.</text>
        }
    </p>
</div>

@if (TempData["Success"] is string mensajeExito)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle" aria-hidden="true"></i> @mensajeExito
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData["Error"] is string mensajeError)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @mensajeError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (!Model.HayCicloActivo)
{
    @* ── Estado vacío 1: sin ciclo activo (UX-05) ── *@
    <div class="card-pe">
        <div class="empty-state">
            <i class="bi bi-calendar-range empty-state__icon" aria-hidden="true"></i>
            <h3 class="empty-state__title">No hay un ciclo activo</h3>
            <p class="empty-state__message">El Gantt del plan se construye sobre el ciclo activo del tenant. Activa un ciclo desde Configuración → Ciclos.</p>
            <a class="btn-pe btn-pe--secondary" asp-controller="Ciclo" asp-action="Index">
                <i class="bi bi-calendar-range" aria-hidden="true"></i> Ver ciclos
            </a>
        </div>
    </div>
}
else if (!Model.HayAcciones)
{
    @* ── Estado vacío 2: ciclo activo sin acciones (UX-05).
          El contenedor del chart NO se renderiza: nunca un chart vacío. ── *@
    <div class="card-pe">
        <div class="empty-state">
            <i class="bi bi-list-check empty-state__icon" aria-hidden="true"></i>
            <h3 class="empty-state__title">No hay acciones en el plan</h3>
            <p class="empty-state__message">
                @if (esGerente)
                {
                    <text>El ciclo @Model.CicloNombre todavía no tiene acciones en el plan. Desglose los objetivos CG en acciones con fechas y responsables.</text>
                }
                else
                {
                    <text>El ciclo @Model.CicloNombre todavía no tiene acciones en el plan de su área. Desglose sus objetivos CG en acciones con fechas y responsables.</text>
                }
            </p>
            @if (!esGerente)
            {
                <a class="btn-pe btn-pe--secondary" asp-action="Index">
                    <i class="bi bi-list-check" aria-hidden="true"></i> Ir al Plan de Acción
                </a>
            }
        </div>
    </div>
}
else
{
    @* ── Filtros (CA #5 + CA #5 bis / F6) — de cliente sobre el payload ya
          cargado: no hay form GET, no hay AJAX y no se vuelve a llamar a la API. ── *@
    <div class="card-pe mb-4" id="ganttFiltrosCard" data-es-gerente="@(esGerente ? "true" : "false")">
        <div class="row g-3 align-items-end">
            <div class="col-md-6 col-lg-3">
                <label class="form-pe-label" for="filtroObjetivoCg">Objetivo CG</label>
                <select class="form-pe-select" id="filtroObjetivoCg">
                    <option value="">Todos los objetivos CG</option>
                </select>
            </div>
            <div class="col-md-6 col-lg-3">
                <label class="form-pe-label" for="filtroStatus">Status</label>
                <select class="form-pe-select" id="filtroStatus">
                    <option value="">Todos los status</option>
                    <option value="Terminado">Terminado</option>
                    <option value="EnProgreso">En progreso</option>
                    <option value="Atrasado">Atrasado</option>
                    <option value="NoIniciado">No iniciado</option>
                </select>
            </div>
            <div class="col-md-6 col-lg-3">
                <label class="form-pe-label" for="filtroClasificacion">Clasificación</label>
                <select class="form-pe-select" id="filtroClasificacion">
                    <option value="">Todas las clasificaciones</option>
                    <option value="Proyecto">Proyecto</option>
                    <option value="Iniciativa">Iniciativa</option>
                    <option value="Operativa">Operativa</option>
                </select>
            </div>
            @* F6 — el selector de área se renderiza SOLO con rol Gerente. *@
            @if (esGerente)
            {
                <div class="col-md-6 col-lg-3">
                    <label class="form-pe-label" for="filtroArea">Área</label>
                    <select class="form-pe-select" id="filtroArea">
                        <option value="">Todas las áreas</option>
                    </select>
                </div>
            }
            <div class="col-12 d-flex flex-wrap align-items-center gap-2">
                <button type="button" class="btn-pe btn-pe--secondary" data-limpiar-filtros>
                    <i class="bi bi-x-circle" aria-hidden="true"></i> Limpiar filtros
                </button>
                <span class="body-sm ms-auto">
                    @TotalAcciones() @(TotalAcciones() == 1 ? "acción" : "acciones") en el plan · escala de @Model.Escala.Count meses
                </span>
            </div>
        </div>
    </div>

    @* ── Gantt: leyenda (CA #2 / UX-02) + chart + estado vacío de filtros ── *@
    <div class="card-pe">
        <div class="gantt-legend">
            <span class="gantt-legend__title">Leyenda:</span>
            <span class="semaforo semaforo--verde">
                <i class="bi bi-circle-fill" aria-hidden="true"></i> Terminado · @Conteo("Terminado")
            </span>
            <span class="semaforo semaforo--amarillo">
                <i class="bi bi-circle-fill" aria-hidden="true"></i> En progreso · @Conteo("EnProgreso")
            </span>
            <span class="semaforo semaforo--rojo">
                <i class="bi bi-circle-fill" aria-hidden="true"></i> Atrasado · @Conteo("Atrasado")
            </span>
            <span class="semaforo semaforo--gris">
                <i class="bi bi-circle-fill" aria-hidden="true"></i> No iniciado · @Conteo("NoIniciado")
            </span>
            <span class="gantt-legend__item">
                <i class="gantt-legend__swatch gantt-legend__swatch--cg"></i> Objetivo CG (resumen)
            </span>
        </div>

        <div id="gantt-pe" class="gantt-pe"></div>

        @* ── Estado vacío 3: los filtros dejan 0 coincidencias (UX-05) ── *@
        <div class="d-none" id="ganttSinCoincidencias">
            <div class="empty-state">
                <i class="bi bi-funnel empty-state__icon" aria-hidden="true"></i>
                <h3 class="empty-state__title">Ninguna acción coincide con los filtros</h3>
                <p class="empty-state__message">Ajuste o quite los filtros para volver a ver el plan completo del ciclo.</p>
                <button type="button" class="btn-pe btn-pe--secondary" data-limpiar-filtros>
                    <i class="bi bi-x-circle" aria-hidden="true"></i> Limpiar filtros
                </button>
            </div>
        </div>
    </div>

    @* Enlace cruzado (F7). El listado AccionPlan/Index es [Authorize(Roles = "JefeArea")],
       así que el botón solo se ofrece a quien realmente puede abrirlo. *@
    @if (!esGerente)
    {
        <div class="d-flex gap-2 mt-3">
            <a class="btn-pe btn-pe--secondary" asp-action="Index">
                <i class="bi bi-list-check" aria-hidden="true"></i> Ver listado
            </a>
        </div>
    }
}

@* El payload viaja embebido por el controller MVC (D-3, ADR-009) y se serializa con
   JavaScriptEncoder.Default → nada de UnsafeRelaxedJsonEscaping (SEC-05). gantt-plan.js
   lo lee de aquí: la vista NO vuelve a llamar a la API. *@
<script id="gantt-plan-data" type="application/json">@Html.Raw(Model.JsonPlan)</script>

@section Scripts {
    <script src="~/js/gantt-plan.js" asp-append-version="true"></script>
}
