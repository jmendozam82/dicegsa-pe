@model AccionPlanProgresoViewModel
@{
    ViewData["Title"] = "Actualizar Progreso";
}

@functions {
    string ClaseStatus(string? status) => status switch
    {
        "Terminado" => "semaforo--verde",
        "EnProgreso" => "semaforo--amarillo",
        "Atrasado" => "semaforo--rojo",
        _ => "semaforo--amarillo"
    };
}

<div class="page-header">
    <div class="page-header__breadcrumb">
        <span>Mi Área</span>
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
        <span>Plan de Acción</span>
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
        <span class="active">Actualizar Progreso</span>
    </div>
    <h1 class="page-header__title">Actualizar Progreso</h1>
    <p class="page-header__subtitle">El status se recalcula automáticamente según el % de progreso y las fechas (RN-017).</p>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
        <strong>No se pudo actualizar el progreso:</strong>
        <ul class="mb-0 mt-1">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<div class="card-pe mb-4">
    @* ── Contexto de la acción ── *@
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <span class="cell-codigo">@Model.Codigo</span>
        <span class="fw-semibold">@Model.Descripcion</span>
        @if (!string.IsNullOrWhiteSpace(Model.ObjetivoCgCodigo))
        {
            <span class="badge text-bg-secondary">@Model.ObjetivoCgCodigo</span>
        }
    </div>
    <div class="row g-3">
        <div class="col-md-3">
            <span class="body-sm d-block">Progreso actual</span>
            <span class="fw-semibold">@Model.Progreso.ToString("0.##")%</span>
        </div>
        <div class="col-md-3">
            <span class="body-sm d-block">Status actual</span>
            <span class="semaforo @ClaseStatus(Model.Status)">
                <i class="bi bi-circle-fill" aria-hidden="true"></i> @Model.Status
            </span>
        </div>
        <div class="col-md-3">
            <span class="body-sm d-block">Vencimiento</span>
            <span class="fw-semibold">@Model.FechaVencimiento.ToString("dd/MM/yyyy")</span>
        </div>
        <div class="col-md-3">
            <span class="body-sm d-block">Peso / Puntuación ponderada</span>
            <span class="fw-semibold">@Model.Peso.ToString("0.##") / @Model.PuntuacionPonderada.ToString("0.###")</span>
        </div>
    </div>
</div>

<div class="card-pe">
    <form asp-action="Progreso" asp-route-id="@Model.AccionId" method="post" id="formProgreso" novalidate>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-pe-label" for="progreso">% de progreso (0 – 100) *</label>
                <input class="form-pe-input" type="number" id="progreso" name="progreso" step="0.01" min="0" max="100"
                       value="@Model.Progreso.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
                <span class="body-sm">Hasta 2 decimales. 100% marca la acción como Terminada (RN-017).</span>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn-pe btn-pe--primary">
                <i class="bi bi-check-lg" aria-hidden="true"></i> Guardar progreso
            </button>
            <a class="btn-pe btn-pe--secondary" asp-action="Index" asp-route-objetivoCgId="@Model.ObjetivoCgId">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(function () {
            $('#formProgreso').validate({
                rules: {
                    progreso: { required: true, min: 0, max: 100 }
                },
                messages: {
                    progreso: {
                        required: 'El % de progreso es requerido.',
                        min: 'El progreso no puede ser menor a 0.',
                        max: 'El progreso no puede exceder 100.'
                    }
                },
                errorElement: 'span',
                errorClass: 'form-pe-error',
                errorPlacement: function (error, element) {
                    error.insertAfter(element);
                }
            });
        });
    </script>
}