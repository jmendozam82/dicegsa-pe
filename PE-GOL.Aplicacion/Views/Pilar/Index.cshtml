@model PilaresIndexViewModel
@{
    ViewData["Title"] = "Pilares Estratégicos";
}

<div class="page-header">
    <div class="page-header__breadcrumb">
        <span>Contenido</span>
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
        <span class="active">Pilares</span>
    </div>
    <h1 class="page-header__title">Pilares Estratégicos</h1>
    <p class="page-header__subtitle">Los ejes temáticos que estructuran el plan estratégico del ciclo (máximo 8).</p>
</div>

@if (TempData["Success"] is string mensajeExito)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle" aria-hidden="true"></i> @mensajeExito
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData["Error"] is string mensajeError)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @mensajeError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@* ── Selector de ciclo (form GET a Index) ── *@
<div class="card-pe mb-4">
    <form method="get" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-pe-label" for="cicloId">Ciclo</label>
            <select class="form-pe-select" id="cicloId" name="cicloId" onchange="this.form.submit()">
                <option value="">Seleccione un ciclo</option>
                @foreach (var ciclo in Model.Ciclos)
                {
                    <option value="@ciclo.Id" selected="@(Model.CicloId == ciclo.Id)">
                        @ciclo.Nombre (@ciclo.AñoFiscal) — @ciclo.Estado
                    </option>
                }
            </select>
        </div>
        <div class="col-md-7 d-flex gap-2">
            <button type="submit" class="btn-pe btn-pe--primary">
                <i class="bi bi-funnel" aria-hidden="true"></i> Ver pilares
            </button>
            @if (Model.EsGerente && Model.CicloId.HasValue)
            {
                <a class="btn-pe btn-pe--primary ms-auto" asp-action="Crear" asp-route-cicloId="@Model.CicloId">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> Nuevo Pilar
                </a>
            }
        </div>
    </form>
</div>

@if (!Model.CicloId.HasValue)
{
    @* ── Estado vacío: sin ciclo seleccionado (UX-05) ── *@
    <div class="card-pe">
        <div class="empty-state">
            <i class="bi bi-columns-gap empty-state__icon" aria-hidden="true"></i>
            <h3 class="empty-state__title">Seleccione un ciclo</h3>
            <p class="empty-state__message">Elija un ciclo del selector para ver sus Pilares Estratégicos.</p>
        </div>
    </div>
}
else if (Model.Items.Count == 0)
{
    @* ── Estado vacío: ciclo sin pilares (UX-05) ── *@
    <div class="card-pe">
        <div class="empty-state">
            <i class="bi bi-columns-gap empty-state__icon" aria-hidden="true"></i>
            <h3 class="empty-state__title">No hay pilares en este ciclo</h3>
            <p class="empty-state__message">Agrega el primer pilar estratégico del ciclo @Model.CicloNombre.</p>
            @if (Model.EsGerente)
            {
                <a class="btn-pe btn-pe--primary" asp-action="Crear" asp-route-cicloId="@Model.CicloId">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> Nuevo Pilar
                </a>
            }
        </div>
    </div>
}
else
{
    @* ── Tabla (UX-03) ── *@
    <div class="card-pe p-0">
        <div class="table-responsive">
            <table class="tabla-pe mb-0">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Estrategia de victoria</th>
                        <th>Orden</th>
                        <th class="text-center">CGs</th>
                        <th class="text-center">OKRs</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pilar in Model.Items)
                    {
                        <tr>
                            <td><span class="cell-codigo">@pilar.Codigo</span></td>
                            <td class="fw-semibold">@pilar.Nombre</td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(pilar.EstrategiaVictoria))
                                {
                                    <span class="text-secondary">—</span>
                                }
                                else
                                {
                                    <span class="cell-truncate d-inline-block" title="@pilar.EstrategiaVictoria">@pilar.EstrategiaVictoria</span>
                                }
                            </td>
                            <td>@pilar.Orden</td>
                            <td class="text-center">
                                <span class="badge text-bg-secondary">@pilar.TotalObjetivosCg</span>
                            </td>
                            <td class="text-center">
                                <span class="badge text-bg-secondary">@pilar.TotalOkrs</span>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a class="btn-pe btn-pe--secondary btn-pe--sm" asp-action="ObjetivosTrimestrales"
                                       asp-route-cicloId="@Model.CicloId" asp-route-id="@pilar.Id" title="Objetivos trimestrales">
                                        <i class="bi bi-calendar4-week" aria-hidden="true"></i>
                                    </a>
                                    @if (Model.EsGerente)
                                    {
                                        <a class="btn-pe btn-pe--secondary btn-pe--sm" asp-action="Editar"
                                           asp-route-cicloId="@Model.CicloId" asp-route-id="@pilar.Id" title="Editar">
                                            <i class="bi bi-pencil" aria-hidden="true"></i>
                                        </a>
                                        <button type="button" class="btn-pe btn-pe--danger btn-pe--sm"
                                                data-bs-toggle="modal" data-bs-target="#modalEliminarPilar"
                                                data-pilar-id="@pilar.Id" data-pilar-nombre="@pilar.Nombre" data-pilar-codigo="@pilar.Codigo"
                                                data-ciclo-id="@Model.CicloId"
                                                title="Eliminar">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@* ── Modal de confirmación eliminar (DS § 5.7) ── *@
<div class="modal fade modal-pe" id="modalEliminarPilar" tabindex="-1" aria-labelledby="modalEliminarTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalEliminarTitulo">Eliminar pilar</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="body-md mb-0" id="modalEliminarTexto"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-pe btn-pe--secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="formEliminarPilar" method="post" action="">
                    <button type="submit" class="btn-pe btn-pe--danger">Eliminar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pilares.js" asp-append-version="true"></script>
}