@model AreaFormViewModel
@{
    ViewData["Title"] = "Editar Área";
}

<div class="page-header">
    <div class="page-header__breadcrumb">
        <span>Configuración</span>
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
        <span>Áreas</span>
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
        <span class="active">@Model.Nombre</span>
    </div>
    <h1 class="page-header__title">Editar Área</h1>
    <p class="page-header__subtitle">Actualiza los datos del área estratégica.</p>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
        <strong>No se pudo guardar el área:</strong>
        <ul class="mb-0 mt-1">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

@if (!Model.Activa)
{
    <div class="alert alert-info" role="alert">
        <i class="bi bi-info-circle" aria-hidden="true"></i>
        El área está <strong>inactiva</strong>: sus datos permanecen en solo lectura (CA #5). El responsable
        puede quedar vacío (RN-011 aplica solo a áreas activas).
    </div>
}

<div class="card-pe">
    <form asp-action="Editar" asp-route-cicloId="@Model.CicloId" asp-route-id="@Model.AreaId" method="post" id="formArea" novalidate>
        <div class="row g-3">
            <div class="col-md-3">
                <span class="form-pe-label d-block">Código</span>
                <span class="cell-codigo">@Model.Codigo</span>
            </div>
            <div class="col-md-3">
                <span class="form-pe-label d-block">Estado</span>
                @if (Model.Activa)
                {
                    <span class="semaforo semaforo--verde">
                        <i class="bi bi-circle-fill" aria-hidden="true"></i> Activa
                    </span>
                }
                else
                {
                    <span class="semaforo semaforo--rojo">
                        <i class="bi bi-circle-fill" aria-hidden="true"></i> Inactiva
                    </span>
                }
            </div>
            <div class="col-md-6">
                <label class="form-pe-label" for="nombre">Nombre *</label>
                <input class="form-pe-input" type="text" id="nombre" name="nombre" value="@Model.Nombre"
                       maxlength="150" placeholder="Ej: Gerencia de Operaciones" @(Model.Activa ? "" : "disabled") />
            </div>
            <div class="col-md-6">
                <label class="form-pe-label" for="responsableId">Responsable <span class="body-sm text-muted">(opcional)</span></label>
                <select class="form-pe-select" id="responsableId" name="responsableId" @(Model.Activa ? "" : "disabled")>
                    <option value="">Sin responsable (vacío libera al Jefe de Área)</option>
                    @foreach (var candidato in Model.Candidatos)
                    {
                        <option value="@candidato.Id" selected="@(Model.ResponsableId == candidato.Id)">
                            @candidato.Nombre (@candidato.Correo)@(candidato.YaAsignado ? " — ya asignado" : "")
                        </option>
                    }
                </select>
            </div>
            <div class="col-12">
                <label class="form-pe-label" for="comentarios">Comentarios</label>
                <textarea class="form-pe-input" id="comentarios" name="comentarios" rows="3"
                          placeholder="Comentarios sobre el área" @(Model.Activa ? "" : "disabled")>@Model.Comentarios</textarea>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            @if (Model.Activa)
            {
                <button type="submit" class="btn-pe btn-pe--primary">
                    <i class="bi bi-check-lg" aria-hidden="true"></i> Guardar
                </button>
            }
            <a class="btn-pe btn-pe--secondary" asp-action="Index" asp-route-cicloId="@Model.CicloId">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(function () {
            $('#formArea').validate({
                rules: {
                    nombre: { required: true, maxlength: 150 }
                },
                messages: {
                    nombre: {
                        required: 'El nombre es obligatorio.',
                        maxlength: 'El nombre no puede superar 150 caracteres.'
                    }
                },
                errorElement: 'span',
                errorClass: 'form-pe-error',
                errorPlacement: function (error, element) {
                    error.insertAfter(element);
                }
            });
        });
    </script>
}