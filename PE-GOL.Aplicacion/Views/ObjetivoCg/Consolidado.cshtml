@model ObjetivoCgConsolidadoViewModel
@{
    ViewData["Title"] = "Objetivos CG Consolidados";
}

@functions {
    string ClaseSemaforo(string? semaforo) => semaforo switch
    {
        "Verde" => "semaforo--verde",
        "Amarillo" => "semaforo--amarillo",
        "Rojo" => "semaforo--rojo",
        _ => "semaforo--amarillo"
    };
}

<div class="page-header">
    <div class="page-header__breadcrumb">
        <span>Contenido</span>
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
        <span class="active">Objetivos CG</span>
    </div>
    <h1 class="page-header__title">Objetivos CG Consolidados</h1>
    <p class="page-header__subtitle">
        @if (Model.HayCicloActivo)
        {
            <text>Vista consolidada de los objetivos de todas las áreas del ciclo <strong>@Model.CicloNombre</strong>.</text>
        }
        else
        {
            <text>Vista consolidada de los objetivos de todas las áreas del ciclo activo.</text>
        }
    </p>
</div>

@if (TempData["Error"] is string mensajeError)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @mensajeError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (!Model.HayCicloActivo)
{
    @* ── Estado vacío: sin ciclo activo (UX-05) ── *@
    <div class="card-pe">
        <div class="empty-state">
            <i class="bi bi-bullseye empty-state__icon" aria-hidden="true"></i>
            <h3 class="empty-state__title">No hay un ciclo activo</h3>
            <p class="empty-state__message">La vista consolidada se construye sobre el ciclo activo del tenant. Activa un ciclo desde Configuración → Ciclos.</p>
        </div>
    </div>
}
else
{
    @* ── Filtros (form GET a Consolidado) ── *@
    <div class="card-pe mb-4">
        <form method="get" asp-action="Consolidado" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-pe-label" for="areaId">Área</label>
                <select class="form-pe-select" id="areaId" name="AreaId">
                    <option value="">Todas las áreas</option>
                    @foreach (var area in Model.Areas)
                    {
                        <option value="@area.Id" selected="@(Model.Filtros.AreaId == area.Id)">@area.Codigo — @area.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-pe-label" for="pilarId">Pilar</label>
                <select class="form-pe-select" id="pilarId" name="PilarId">
                    <option value="">Todos los pilares</option>
                    @foreach (var pilar in Model.Pilares)
                    {
                        <option value="@pilar.Id" selected="@(Model.Filtros.PilarId == pilar.Id)">@pilar.Codigo — @pilar.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-pe-label" for="trimestre">Trimestre</label>
                <select class="form-pe-select" id="trimestre" name="Trimestre">
                    <option value="">Todos</option>
                    <option value="Q1" selected="@(Model.Filtros.Trimestre == "Q1")">Trimestre 1</option>
                    <option value="Q2" selected="@(Model.Filtros.Trimestre == "Q2")">Trimestre 2</option>
                    <option value="Q3" selected="@(Model.Filtros.Trimestre == "Q3")">Trimestre 3</option>
                    <option value="Q4" selected="@(Model.Filtros.Trimestre == "Q4")">Trimestre 4</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-pe-label" for="semaforo">Semáforo</label>
                <select class="form-pe-select" id="semaforo" name="Semaforo">
                    <option value="">Todos</option>
                    <option value="Verde" selected="@(Model.Filtros.Semaforo == "Verde")">Verde</option>
                    <option value="Amarillo" selected="@(Model.Filtros.Semaforo == "Amarillo")">Amarillo</option>
                    <option value="Rojo" selected="@(Model.Filtros.Semaforo == "Rojo")">Rojo</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn-pe btn-pe--primary">
                    <i class="bi bi-funnel" aria-hidden="true"></i> Filtrar
                </button>
                <a class="btn-pe btn-pe--secondary" asp-action="Consolidado" title="Limpiar filtros">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </a>
            </div>
        </form>
    </div>

    @if (Model.Items.Count == 0)
    {
        @* ── Estado vacío: sin resultados (UX-05) ── *@
        <div class="card-pe">
            <div class="empty-state">
                <i class="bi bi-bullseye empty-state__icon" aria-hidden="true"></i>
                <h3 class="empty-state__title">Sin objetivos para mostrar</h3>
                <p class="empty-state__message">No hay objetivos CG que coincidan con los filtros seleccionados.</p>
            </div>
        </div>
    }
    else
    {
        @* ── Tabla consolidada (UX-03) ── *@
        <div class="card-pe p-0">
            <div class="table-responsive">
                <table class="tabla-pe mb-0">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Descripción</th>
                            <th>Área</th>
                            <th>Pilar</th>
                            <th class="text-center">Trimestre</th>
                            <th class="text-center">Progreso</th>
                            <th>Semáforo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td><span class="cell-codigo">@item.Codigo</span></td>
                                <td>
                                    <span class="cell-truncate d-inline-block" title="@item.Descripcion">@item.Descripcion</span>
                                </td>
                                <td>
                                    <span class="cell-codigo">@item.AreaCodigo</span>
                                    <span class="ms-1">@item.AreaNombre</span>
                                </td>
                                <td>@item.PilarNombre</td>
                                <td class="text-center">@item.TrimestreObjetivo</td>
                                <td class="text-center">@((item.Progreso * 100).ToString("0"))%</td>
                                <td>
                                    <span class="semaforo @ClaseSemaforo(item.Semaforo)">
                                        <i class="bi bi-circle-fill" aria-hidden="true"></i> @item.Semaforo
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}