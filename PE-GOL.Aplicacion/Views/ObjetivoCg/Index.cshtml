@model ObjetivoCgIndexViewModel
@{
    ViewData["Title"] = "Objetivos CG de mi Área";
}

@functions {
    string ClaseSemaforo(string? semaforo) => semaforo switch
    {
        "Verde" => "semaforo--verde",
        "Amarillo" => "semaforo--amarillo",
        "Rojo" => "semaforo--rojo",
        _ => "semaforo--amarillo"
    };
}

<div class="page-header">
    <div class="page-header__breadcrumb">
        <span>Mi Área</span>
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
        <span class="active">Objetivos CG</span>
    </div>
    <h1 class="page-header__title">Objetivos CG de mi Área</h1>
    <p class="page-header__subtitle">
        @if (Model.HayCicloActivo)
        {
            <text>Compromisos estratégicos de su área en el ciclo <strong>@Model.CicloNombre</strong>.</text>
        }
        else
        {
            <text>Compromisos estratégicos de su área en el ciclo activo.</text>
        }
    </p>
</div>

@if (TempData["Success"] is string mensajeExito)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle" aria-hidden="true"></i> @mensajeExito
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData["Error"] is string mensajeError)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @mensajeError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (!Model.HayCicloActivo)
{
    @* ── Estado vacío: sin ciclo activo (UX-05) ── *@
    <div class="card-pe">
        <div class="empty-state">
            <i class="bi bi-bullseye empty-state__icon" aria-hidden="true"></i>
            <h3 class="empty-state__title">No hay un ciclo activo</h3>
            <p class="empty-state__message">Los objetivos CG se registran sobre el ciclo activo del tenant. Activa un ciclo desde Configuración → Ciclos.</p>
        </div>
    </div>
}
else if (Model.Items.Count == 0)
{
    @* ── Estado vacío: sin objetivos CG (UX-05) ── *@
    <div class="card-pe">
        <div class="empty-state">
            <i class="bi bi-bullseye empty-state__icon" aria-hidden="true"></i>
            <h3 class="empty-state__title">No hay objetivos CG en su área</h3>
            <p class="empty-state__message">Registre el primer objetivo estratégico de su área para el ciclo @Model.CicloNombre.</p>
            <a class="btn-pe btn-pe--primary" asp-action="Crear">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> Nuevo Objetivo CG
            </a>
        </div>
    </div>
}
else
{
    @* ── Tabla (UX-03) ── *@
    <div class="d-flex justify-content-end mb-3">
        <a class="btn-pe btn-pe--primary" asp-action="Crear">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Nuevo Objetivo CG
        </a>
    </div>
    <div class="card-pe p-0">
        <div class="table-responsive">
            <table class="tabla-pe mb-0">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Descripción</th>
                        <th>Pilar</th>
                        <th class="text-center">Trimestre</th>
                        <th class="text-center">Progreso</th>
                        <th>Semáforo</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cg in Model.Items)
                    {
                        <tr>
                            <td><span class="cell-codigo">@cg.Codigo</span></td>
                            <td>
                                <span class="cell-truncate d-inline-block" title="@cg.Descripcion">@cg.Descripcion</span>
                            </td>
                            <td>@cg.PilarNombre</td>
                            <td class="text-center">@cg.TrimestreObjetivo</td>
                            <td class="text-center">@((cg.Progreso * 100).ToString("0"))%</td>
                            <td>
                                <span class="semaforo @ClaseSemaforo(cg.Semaforo)">
                                    <i class="bi bi-circle-fill" aria-hidden="true"></i> @cg.Semaforo
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a class="btn-pe btn-pe--secondary btn-pe--sm" asp-controller="AccionPlan"
                                       asp-action="Index" asp-route-objetivoCgId="@cg.Id" title="Ver plan de acción">
                                        <i class="bi bi-list-check" aria-hidden="true"></i>
                                    </a>
                                    <a class="btn-pe btn-pe--secondary btn-pe--sm" asp-action="Editar"
                                       asp-route-id="@cg.Id" title="Editar">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </a>
                                    <button type="button" class="btn-pe btn-pe--danger btn-pe--sm"
                                            data-bs-toggle="modal" data-bs-target="#modalEliminarCg"
                                            data-cg-id="@cg.Id" data-cg-codigo="@cg.Codigo" data-cg-descripcion="@cg.Descripcion"
                                            title="Eliminar">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@* ── Modal de confirmación eliminar (DS § 5.7) ── *@
<div class="modal fade modal-pe" id="modalEliminarCg" tabindex="-1" aria-labelledby="modalEliminarCgTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalEliminarCgTitulo">Eliminar objetivo CG</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="body-md mb-0" id="modalEliminarCgTexto"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-pe btn-pe--secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="formEliminarCg" method="post" action="">
                    <button type="submit" class="btn-pe btn-pe--danger">Eliminar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/objetivoscg.js" asp-append-version="true"></script>
}