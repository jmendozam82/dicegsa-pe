@model TenantsIndexViewModel
@{
    ViewData["Title"] = "Administración de Tenants";
}

<div class="page-header">
    <div class="page-header__breadcrumb">
        <span>Administración SaaS</span>
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
        <span class="active">Tenants</span>
    </div>
    <h1 class="page-header__title">Administración de Tenants</h1>
    <p class="page-header__subtitle">@Model.Total registro(s) · Página @Model.Page de @(Model.TotalPages > 0 ? Model.TotalPages : 1)</p>
</div>

@if (TempData["Success"] is string mensajeExito)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle" aria-hidden="true"></i> @mensajeExito
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData["Error"] is string mensajeError)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @mensajeError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@* ── Barra de filtros (form GET a Index) ── *@
<div class="card-pe mb-4">
    <form method="get" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-pe-label" for="estado">Estado</label>
            <select class="form-pe-select" id="estado" name="estado">
                <option value="">Todos</option>
                <option value="Activo" selected="@(Model.EstadoFiltro == "Activo")">Activo</option>
                <option value="Inactivo" selected="@(Model.EstadoFiltro == "Inactivo")">Inactivo</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-pe-label" for="planId">Plan</label>
            <select class="form-pe-select" id="planId" name="planId">
                <option value="">Todos los planes</option>
                @foreach (var plan in Model.Planes)
                {
                    <option value="@plan.Id" selected="@(Model.PlanIdFiltro == plan.Id)">@plan.Nombre</option>
                }
            </select>
        </div>
        <div class="col-md-5 d-flex gap-2">
            <button type="submit" class="btn-pe btn-pe--primary">
                <i class="bi bi-funnel" aria-hidden="true"></i> Filtrar
            </button>
            <a class="btn-pe btn-pe--secondary" asp-action="Index">
                <i class="bi bi-x-lg" aria-hidden="true"></i> Limpiar
            </a>
            <a class="btn-pe btn-pe--primary ms-auto" asp-action="Create">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> Nuevo Tenant
            </a>
        </div>
    </form>
</div>

@if (Model.Items.Count == 0)
{
    @* ── Estado vacío (UX-05) ── *@
    <div class="card-pe">
        <div class="empty-state">
            <i class="bi bi-building empty-state__icon" aria-hidden="true"></i>
            <h3 class="empty-state__title">No hay tenants registrados</h3>
            <p class="empty-state__message">Agrega el primer tenant para comenzar a administrar las gerencias de la plataforma.</p>
            <a class="btn-pe btn-pe--primary" asp-action="Create">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> Nuevo Tenant
            </a>
        </div>
    </div>
}
else
{
    @* ── Tabla (UX-03) ── *@
    <div class="card-pe p-0">
        <div class="table-responsive">
            <table class="tabla-pe mb-0">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Plan</th>
                        <th>Zona horaria</th>
                        <th>Estado</th>
                        <th>Creado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tenant in Model.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@tenant.Nombre</td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(tenant.Descripcion))
                                {
                                    <span class="text-secondary">—</span>
                                }
                                else
                                {
                                    <span class="cell-truncate d-inline-block" title="@tenant.Descripcion">@tenant.Descripcion</span>
                                }
                            </td>
                            <td>
                                <span class="badge border text-secondary">@tenant.PlanNombre</span>
                            </td>
                            <td>@tenant.ZonaHoraria</td>
                            <td>
                                @if (tenant.Estado == "Activo")
                                {
                                    <span class="semaforo semaforo--verde">
                                        <i class="bi bi-circle-fill" aria-hidden="true"></i> Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="semaforo semaforo--rojo">
                                        <i class="bi bi-circle-fill" aria-hidden="true"></i> Inactivo
                                    </span>
                                }
                            </td>
                            <td>@tenant.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a class="btn-pe btn-pe--secondary btn-pe--sm" asp-action="Edit" asp-route-id="@tenant.Id" title="Editar">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </a>
                                    @if (tenant.Estado == "Activo")
                                    {
                                        <button type="button" class="btn-pe btn-pe--secondary btn-pe--sm"
                                                data-bs-toggle="modal" data-bs-target="#modalConfirmarAccion"
                                                data-tenant-id="@tenant.Id" data-tenant-nombre="@tenant.Nombre" data-accion="desactivar"
                                                title="Desactivar">
                                            <i class="bi bi-stop-circle" aria-hidden="true"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn-pe btn-pe--secondary btn-pe--sm"
                                                data-bs-toggle="modal" data-bs-target="#modalConfirmarAccion"
                                                data-tenant-id="@tenant.Id" data-tenant-nombre="@tenant.Nombre" data-accion="activar"
                                                title="Activar">
                                            <i class="bi bi-play-circle" aria-hidden="true"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* ── Paginación (preserva filtros activos) ── *@
    <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 gap-2">
        <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
            <input type="hidden" name="estado" value="@Model.EstadoFiltro" />
            <input type="hidden" name="planId" value="@Model.PlanIdFiltro" />
            <label class="form-pe-label mb-0" for="pageSize">Registros por página</label>
            <select class="form-pe-select w-auto" id="pageSize" name="pageSize" onchange="this.form.submit()">
                <option value="10" selected="@(Model.PageSize == 10)">10</option>
                <option value="25" selected="@(Model.PageSize == 25)">25</option>
                <option value="50" selected="@(Model.PageSize == 50)">50</option>
            </select>
        </form>

        <nav aria-label="Paginación de tenants">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize"
                       asp-route-estado="@Model.EstadoFiltro" asp-route-planId="@Model.PlanIdFiltro">Anterior</a>
                </li>
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@i" asp-route-pageSize="@Model.PageSize"
                           asp-route-estado="@Model.EstadoFiltro" asp-route-planId="@Model.PlanIdFiltro">@i</a>
                    </li>
                }
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize"
                       asp-route-estado="@Model.EstadoFiltro" asp-route-planId="@Model.PlanIdFiltro">Siguiente</a>
                </li>
            </ul>
        </nav>
    </div>
}

@* ── Modal de confirmación activar/desactivar (DS § 5.7) ── *@
<div class="modal fade modal-pe" id="modalConfirmarAccion" tabindex="-1" aria-labelledby="modalConfirmarTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalConfirmarTitulo">Confirmar acción</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="body-md mb-0" id="modalConfirmarTexto"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-pe btn-pe--secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="formConfirmarAccion" method="post" action="">
                    <button type="submit" id="modalConfirmarBoton" class="btn-pe btn-pe--danger">Confirmar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/tenants.js" asp-append-version="true"></script>
}