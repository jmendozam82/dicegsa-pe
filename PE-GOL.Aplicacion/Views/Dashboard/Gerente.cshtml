@model DashboardGerenteViewModel
@{
    ViewData["Title"] = "Tablero del Gerente";
}

@functions {
    string ClaseSemaforo(string? semaforo) => semaforo switch
    {
        "Verde" => "semaforo--verde",
        "Amarillo" => "semaforo--amarillo",
        "Rojo" => "semaforo--rojo",
        _ => "semaforo--amarillo"
    };
}

<div class="page-header">
    <div class="page-header__breadcrumb">
        <span>Contenido</span>
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
        <span class="active">Dashboard</span>
    </div>
    <h1 class="page-header__title">Tablero del Gerente</h1>
    <p class="page-header__subtitle">
        @if (Model.Tablero is not null)
        {
            <text>Consolidado del ciclo <strong>@Model.Tablero.CicloNombre</strong> (@Model.Tablero.AñoFiscal) — todas las áreas activas.</text>
        }
        else
        {
            <text>Consolidado del ciclo activo — todas las áreas.</text>
        }
    </p>
</div>

@if (TempData["Error"] is string mensajeError)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @mensajeError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (Model.Tablero is null)
{
    @* ── Estado vacío: sin ciclo activo (UX-05) ── *@
    <div class="card-pe">
        <div class="empty-state">
            <i class="bi bi-speedometer2 empty-state__icon" aria-hidden="true"></i>
            <h3 class="empty-state__title">No hay un ciclo activo</h3>
            <p class="empty-state__message">El tablero se construye sobre el ciclo activo del tenant. Activa un ciclo desde Configuración → Ciclos.</p>
        </div>
    </div>
}
else
{
    var tablero = Model.Tablero;

    @* ── KPIs consolidados (DS § 5.1 — CA #2 y CA #4) ── *@
    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="kpi-card kpi-card--verde">
                <div class="kpi-card__icon"><i class="bi bi-list-check" aria-hidden="true"></i></div>
                <div>
                    <span class="kpi-card__label">Total acciones del ciclo</span>
                    <span class="kpi-card__value">@tablero.Totales.TotalAcciones</span>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="kpi-card kpi-card--rojo">
                <div class="kpi-card__icon"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></div>
                <div>
                    <span class="kpi-card__label">Acciones atrasadas</span>
                    <span class="kpi-card__value">@tablero.Totales.AccionesAtrasadas</span>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="kpi-card kpi-card--amarillo">
                <div class="kpi-card__icon"><i class="bi bi-bullseye" aria-hidden="true"></i></div>
                <div>
                    <span class="kpi-card__label">Promedio OKRs global</span>
                    <span class="kpi-card__value">@((tablero.Totales.PromedioOkrs * 100).ToString("0"))%</span>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="kpi-card kpi-card--rojo">
                <div class="kpi-card__icon"><i class="bi bi-bell" aria-hidden="true"></i></div>
                <div>
                    <span class="kpi-card__label">Áreas con alerta activa</span>
                    <span class="kpi-card__value">@tablero.AreasConAlertaActiva</span>
                </div>
            </div>
        </div>
    </div>

    @* ── Paneles por área (CA #1) ── *@
    if (tablero.Paneles.Count == 0)
    {
        <div class="card-pe">
            <div class="empty-state">
                <i class="bi bi-diagram-3 empty-state__icon" aria-hidden="true"></i>
                <h3 class="empty-state__title">Sin áreas activas</h3>
                <p class="empty-state__message">No hay áreas activas en el ciclo @tablero.CicloNombre. Agrega áreas desde Configuración → Áreas.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card-pe p-0">
            <div class="table-responsive">
                <table class="tabla-pe mb-0">
                    <thead>
                        <tr>
                            <th>Área</th>
                            <th>Semáforo global</th>
                            <th>Avance OKRs</th>
                            <th>Avance Plan de Acción</th>
                            <th class="text-center">Acciones atrasadas</th>
                            <th class="text-center">Alerta</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var panel in tablero.Paneles)
                        {
                            <tr>
                                <td>
                                    <span class="cell-codigo">@panel.AreaCodigo</span>
                                    <span class="ms-1 fw-semibold">@panel.AreaNombre</span>
                                </td>
                                <td>
                                    <span class="semaforo @ClaseSemaforo(panel.SemaforoGlobal)">
                                        <i class="bi bi-circle-fill" aria-hidden="true"></i> @panel.SemaforoGlobal
                                    </span>
                                </td>
                                <td>@((panel.AvanceOkrs * 100).ToString("0"))%</td>
                                <td>@((panel.AvancePlanAccion * 100).ToString("0"))%</td>
                                <td class="text-center">
                                    @if (panel.AccionesAtrasadas > 0)
                                    {
                                        <span class="badge text-bg-danger">@panel.AccionesAtrasadas</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-success">0</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (panel.AlertaActiva)
                                    {
                                        <i class="bi bi-bell-fill text-danger" title="Alerta activa" aria-label="Alerta activa"></i>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">—</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a class="btn-pe btn-pe--secondary btn-pe--sm"
                                       asp-controller="ObjetivoCg" asp-action="Consolidado" asp-route-AreaId="@panel.AreaId"
                                       title="Ver objetivos CG del área">
                                        <i class="bi bi-bullseye" aria-hidden="true"></i> Ver CGs
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}