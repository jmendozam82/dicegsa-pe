@model CicloFormViewModel
@{
    ViewData["Title"] = "Nuevo Ciclo";
    var anioActual = DateTime.Now.Year;
}

<div class="page-header">
    <div class="page-header__breadcrumb">
        <span>Configuración</span>
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
        <span>Ciclos</span>
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
        <span class="active">Nuevo Ciclo</span>
    </div>
    <h1 class="page-header__title">Nuevo Ciclo</h1>
    <p class="page-header__subtitle">Crea un ciclo anual en estado Borrador (se generan los umbrales de semáforo por defecto).</p>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
        <strong>No se pudo guardar el ciclo:</strong>
        <ul class="mb-0 mt-1">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<div class="card-pe">
    <form asp-action="Crear" method="post" id="formCiclo" novalidate>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-pe-label" for="nombre">Nombre *</label>
                <input class="form-pe-input" type="text" id="nombre" name="nombre" value="@Model.Nombre"
                       maxlength="100" placeholder="Ej: PE 2026" />
            </div>
            <div class="col-md-3">
                <label class="form-pe-label" for="añoFiscal">Año fiscal *</label>
                <input class="form-pe-input" type="number" id="añoFiscal" name="añoFiscal" value="@Model.AñoFiscal"
                       min="2000" max="2100" />
            </div>
            <div class="col-md-3">
                <label class="form-pe-label" for="mesInicio">Mes de inicio *</label>
                <select class="form-pe-select" id="mesInicio" name="mesInicio">
                    <option value="">Seleccione un mes</option>
                    @for (var mes = 1; mes <= 12; mes++)
                    {
                        <option value="@mes" selected="@(Model.MesInicio == mes)">@System.Globalization.CultureInfo.GetCultureInfo("es-ES").DateTimeFormat.GetMonthName(mes)</option>
                    }
                </select>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn-pe btn-pe--primary">
                <i class="bi bi-check-lg" aria-hidden="true"></i> Guardar
            </button>
            <a class="btn-pe btn-pe--secondary" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(function () {
            $('#formCiclo').validate({
                rules: {
                    nombre: { required: true, maxlength: 100 },
                    añoFiscal: { required: true, number: true, min: 2000, max: 2100 },
                    mesInicio: { required: true, number: true, min: 1, max: 12 }
                },
                messages: {
                    nombre: {
                        required: 'El nombre es obligatorio.',
                        maxlength: 'El nombre no puede superar 100 caracteres.'
                    },
                    añoFiscal: {
                        required: 'El año fiscal es obligatorio.',
                        number: 'Ingrese un año válido.',
                        min: 'El año fiscal debe estar entre 2000 y 2100.',
                        max: 'El año fiscal debe estar entre 2000 y 2100.'
                    },
                    mesInicio: {
                        required: 'Seleccione el mes de inicio.'
                    }
                },
                errorElement: 'span',
                errorClass: 'form-pe-error',
                errorPlacement: function (error, element) {
                    error.insertAfter(element);
                }
            });
        });
    </script>
}