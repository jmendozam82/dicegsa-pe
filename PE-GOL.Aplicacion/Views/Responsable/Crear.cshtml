@model ResponsableFormViewModel
@{
    ViewData["Title"] = "Nuevo Responsable";
}

<div class="page-header">
    <div class="page-header__breadcrumb">
        <span>Configuración</span>
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
        <span>Responsables</span>
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
        <span class="active">Nuevo Responsable</span>
    </div>
    <h1 class="page-header__title">Nuevo Responsable</h1>
    <p class="page-header__subtitle">El usuario debe existir con rol JefeArea en el tenant (RN-010).</p>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
        <strong>No se pudo guardar el responsable:</strong>
        <ul class="mb-0 mt-1">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<div class="card-pe">
    <form asp-action="Crear" asp-route-cicloId="@Model.CicloId" method="post" id="formResponsable" novalidate>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-pe-label" for="nombre">Nombre *</label>
                <input class="form-pe-input" type="text" id="nombre" name="nombre" value="@Model.Nombre"
                       maxlength="150" placeholder="Ej: María López" />
            </div>
            <div class="col-md-6">
                <label class="form-pe-label" for="correo">Correo *</label>
                <input class="form-pe-input" type="email" id="correo" name="correo" value="@Model.Correo"
                       maxlength="150" placeholder="maria.lopez@empresa.com" />
            </div>
            <div class="col-md-6">
                <label class="form-pe-label" for="areaId">Área *</label>
                <select class="form-pe-select" id="areaId" name="areaId">
                    <option value="">Seleccione un área</option>
                    @foreach (var area in Model.Areas)
                    {
                        <option value="@area.Id" selected="@(Model.AreaId == area.Id)">
                            @area.Codigo — @area.Nombre
                        </option>
                    }
                </select>
                @if (Model.Areas.Count == 0)
                {
                    <span class="form-pe-error">No hay áreas disponibles: cree áreas estratégicas primero.</span>
                }
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn-pe btn-pe--primary">
                <i class="bi bi-check-lg" aria-hidden="true"></i> Guardar
            </button>
            <a class="btn-pe btn-pe--secondary" asp-action="Index" asp-route-cicloId="@Model.CicloId">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(function () {
            $('#formResponsable').validate({
                rules: {
                    nombre: { required: true, maxlength: 150 },
                    correo: { required: true, email: true, maxlength: 150 },
                    areaId: { required: true }
                },
                messages: {
                    nombre: {
                        required: 'El nombre es obligatorio.',
                        maxlength: 'El nombre no puede superar 150 caracteres.'
                    },
                    correo: {
                        required: 'El correo es obligatorio.',
                        email: 'Ingrese un correo válido.',
                        maxlength: 'El correo no puede superar 150 caracteres.'
                    },
                    areaId: {
                        required: 'Seleccione un área.'
                    }
                },
                errorElement: 'span',
                errorClass: 'form-pe-error',
                errorPlacement: function (error, element) {
                    error.insertAfter(element);
                }
            });
        });
    </script>
}